{
  "name": "AI content repurposing: send approved drafts, ready to post",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "spreadsheetId": "",
        "sheetId": "Drafts",
        "includesHeaders": true,
        "tableFirstRow": "A1:I1",
        "sortOrder": "asc",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "slack:CreateMessage",
      "version": 4,
      "parameters": {},
      "filter": {
        "name": "Only rows marked approved",
        "conditions": [
          [
            {
              "a": "{{1.`0`}}",
              "b": "approved",
              "o": "text:equal:ci"
            }
          ]
        ]
      },
      "mapper": {
        "channelWType": "list",
        "channelType": "public",
        "channel": "",
        "parse": false,
        "mrkdwn": true,
        "text": ":white_check_mark: *Approved and ready to post:* <{{1.`2`}}|{{1.`1`}}>\n\n*LinkedIn*\n{{1.`3`}}\n\n*X thread* (post each part as a reply to the one before)\n{{1.`4`}}\n\n*Newsletter*\n{{1.`5`}}\n\n*Hashtags:* {{1.`6`}}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "",
        "sheetId": "Drafts",
        "rowNumber": "{{1.__ROW_NUMBER__}}",
        "includesHeaders": true,
        "valueInputOption": "RAW",
        "values": {
          "0": "ready"
        }
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
